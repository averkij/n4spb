{
  "name": "n4spb-nevsky",
  "version": "2.2.1",
  "description": "A walkable anime cel-shaded 3D strip of Saint Petersburg: Moscow Railway Station, Nevsky Prospekt, the district around it, Palace Square, the Hermitage and the Admiralty, with seven metro stations, cars, people, trains, boats and a drivable car; plain three.js, static deploy",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "dev:area": "node tools/area-dev.mjs",
    "check": "node tools/check.mjs environment streets city rail landmarksA landmarksB landmarksC landmarksD landmarksE landmarksF landmarksG landmarksH landmarksI landmarksJ landmarksK landmarksCastle landmarksBelinsky landmarksOktyabrsky landmarksNorth bridges metro props traffic people wildlife",
    "check:north": "node tools/area.mjs north tools/check.mjs --area-modules",
    "layout": "node tools/each-area.mjs tools/layout-test.mjs",
    "layout:north": "node tools/area.mjs north tools/layout-test.mjs",
    "areas": "node tools/areas-test.mjs && node tools/area.mjs north tools/north-hooks-test.mjs",
    "areahtml": "node tools/gen-area-html.mjs",
    "areahtml:check": "node tools/gen-area-html.mjs --check",
    "golden": "node tools/layout-golden.mjs --diff",
    "golden:north": "node tools/area.mjs north tools/layout-golden.mjs --diff",
    "hooks": "node tools/area.mjs north tools/north-hooks-test.mjs",
    "hooks:snapshot": "node tools/area.mjs north tools/north-env-snapshot.mjs --out shots/north-env-snapshot.json",
    "hooks:height": "node tools/area.mjs north tools/north-height-test.mjs",
    "hooks:keepout": "node tools/area.mjs north tools/north-keepout-test.mjs --parallel --footprints",
    "hooks:people": "node tools/north-people-hooks-test.mjs",
    "hooks:syntax": "node tools/hooks-syntax-check.mjs",
    "hooks:all": "npm run hooks:syntax && npm run hooks && npm run hooks:height && npm run hooks:keepout && npm run hooks:people",
    "importlint": "node tools/import-lint.mjs",
    "runtimelint": "node tools/runtime-only-lint.mjs",
    "revtest": "node tools/baked-revision-test.mjs",
    "importmap": "node tools/importmap-probe.mjs",
    "areaboot": "node tools/area-boot-test.mjs",
    "areaboot:north": "node tools/area-boot-test.mjs --page north.html",
    "areahop": "node tools/areas-hop-test.mjs",
    "garage": "node tools/each-area.mjs tools/area-garage-check.mjs",
    "water": "node tools/area.mjs palace tools/water-reachable-test.mjs && node tools/area.mjs smolny tools/water-reachable-test.mjs && node tools/area.mjs admiralty tools/water-reachable-test.mjs && node tools/area.mjs vladimirsky tools/water-reachable-test.mjs",
    "crossplaces": "node tools/each-area.mjs tools/cross-places-test.mjs",
    "northknock": "node tools/area.mjs north tools/north-knock-test.mjs",
    "people:mutant": "node tools/people-test.mjs --mutant jump1m && node tools/area.mjs north tools/people-test.mjs --mutant jump1m",
    "claims-draw": "node tools/each-area.mjs tools/claims-draw-audit.mjs",
    "claims-draw:north": "node tools/area.mjs north tools/claims-draw-audit.mjs --strict",
    "navequiv": "node tools/nav-bake-equiv.mjs",
    "navequiv:north": "node tools/nav-bake-equiv.mjs --area north",
    "tauride:ci": "node tools/tauride/data-test.mjs --no-regen && node tools/tauride-cams-check.mjs && node tools/area.mjs north tools/tauride/ground-test.mjs && node tools/area.mjs north tools/tauride/pond-test.mjs && node tools/area.mjs north tools/tauride-height-test.mjs",
    "handoff": "node tools/handoff-test.mjs",
    "handoffcar": "node tools/area.mjs palace tools/handoff-car-test.mjs && node tools/area.mjs smolny tools/handoff-car-test.mjs && node tools/area.mjs admiralty tools/handoff-car-test.mjs && node tools/area.mjs vladimirsky tools/handoff-car-test.mjs",
    "gates": "node tools/gates-test.mjs",
    "gatehold": "node tools/gate-hold-test.mjs",
    "areasflow": "node tools/areas-flow-test.mjs",
    "areasflow:g3": "node tools/areas-flow-test.mjs --only g3fast,g3",
    "navmemory": "node tools/nav-memory-probe.mjs",
    "smoke": "node tools/smoke.mjs",
    "load": "node tools/load-test.mjs",
    "bake": "node tools/bake-scene.mjs --area all",
    "bake:strip": "node tools/bake-scene.mjs --area strip",
    "bake:north": "node tools/bake-scene.mjs --area north",
    "bakecheck": "node tools/bake-manifest-check.mjs",
    "bakedcheck": "node tools/baked-check.mjs",
    "bakedcheck:north": "node tools/baked-check.mjs --area north",
    "partywalls": "node tools/party-wall-test.mjs",
    "belinsky": "node tools/belinsky-test.mjs",
    "troitsky": "node tools/area.mjs palace tools/troitsky-test.mjs",
    "palacebridge": "node tools/area.mjs palace tools/palacebridge-test.mjs",
    "bridgejump": "node tools/area.mjs palace tools/bridge-jump-test.mjs",
    "wires": "node tools/wires-test.mjs",
    "paving": "node tools/street-paving-test.mjs",
    "roads": "node tools/roads.mjs",
    "ribbons": "node tools/streets-ribbon-audit.mjs",
    "markings": "node tools/streets-markings-audit.mjs --geom --strict",
    "plates": "node tools/streets-plates-sheet.mjs",
    "walls": "node tools/city-wall-audit.mjs",
    "labels": "node tools/city-label-audit.mjs",
    "facade": "node tools/city-facade-test.mjs",
    "clip": "node tools/streets-clip-test.mjs",
    "landmarks": "node tools/each-area.mjs tools/landmarks-groups-check.mjs",
    "edge": "node tools/drive-edge-test.mjs",
    "edgereal": "node tools/drive-edge-real.mjs",
    "knock": "node tools/knock-test.mjs",
    "signals-knock": "node tools/signals-knock-test.mjs",
    "knock-scene": "node tools/knock-scene-test.mjs",
    "knock-stands": "node tools/each-area.mjs tools/knock-stands-test.mjs",
    "hop": "node tools/drive-hop-test.mjs",
    "touch": "node tools/touch-logic-test.mjs",
    "touchbrowser": "node tools/touch-browser-test.mjs",
    "icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1",
    "three": "0.170.0"
  }
}
