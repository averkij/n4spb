node_modules/
shots/
*.log
.playwright-mcp/

# The repository-wide (Python template) .gitignore ignores folders named lib/, parts/, env/, build/, dist/, var/ ...
# This JavaScript project uses such names for source folders, so re-include them.
!**/lib/
!**/parts/
!**/env/
!**/build/
!**/dist/
!**/var/
!**/target/
!**/downloads/

# deploy copy (docs/STRIP.md section 7) and the unfinished chunks of an interrupted bake
/dist/
assets/baked/**/*.part

# Guard: the third-party map screenshot (Yandex Maps) the original data was registered to is a private layout reference and must never be committed or deployed.
docs/reference/yandex-center.png
docs/reference/plan-overlay.png
tools/tauride/raw/

# the lock of a running bake (tools/lib/bake-guard.mjs)
assets/baked/.bake.lock
